# Claude Code settings
.claude/settings.local.json

# Node modules and dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# Build outputs and maps
*.min.css.map
*.min.js.map
dist/
build/

# Wrangler local dev/build cache
.wrangler/

# Wrangler local-dev secrets (IA_WEBSITE_OIDC_SECRET etc.) — also listed in .assetsignore, because
# gitignoring a file does not stop `wrangler deploy` from publishing it as a static asset.
.dev.vars
.dev.vars.*

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~
.code-workspace

# OS files
.DS_Store
Thumbs.db
.Spotlight-V100
.Trashes

# Logs
logs/
*.log

# Temporary files
.tmp/
.cache/
.temp/

# Testing
coverage/
.nyc_output/

# Internal product planning docs (never deploy to public site)
product-plans/

# Personal dev notes / test commands (never deploy to public site)
dev-notes/
.env
